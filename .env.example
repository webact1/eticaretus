DATABASE_URL="file:./dev.db"

# Admin oturum çerezini imzalamak için rastgele, uzun bir gizli anahtar (prod'da değiştir)
SESSION_SECRET="change-me-to-a-long-random-string"

# İlk admin hesabı: `npm run seed` bu bilgilerle bir AdminUser oluşturur (varsa dokunmaz)
# ADMIN_EMAIL giriş ekranındaki "Kullanıcı Adı"dır.
ADMIN_EMAIL="admin"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="Admin"

# Production: deploy klasörünün DIŞINDA kalıcı yollar kullan (bkz. DEPLOY.md)
# DATABASE_URL="file:/var/www/eticaretus-data/prod.db"
# UPLOAD_DIR="/var/www/eticaretus-data/uploads"
